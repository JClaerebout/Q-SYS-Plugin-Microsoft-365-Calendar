function GetProperties()
    local props = { }

	table.insert(props, {
		Type = "integer",
		Name = "pollingInterval",
		Value = 60,
		Min = 1,
		Max = 3600
	})
	table.insert(props, {
		Type = "integer",
		Name = "nextMeetingSoonThreshold",
		Value = 15,
		Min = 1,
		Max = 3600
	})
	table.insert(props, {
        Name = "Timezone",
        Type = "enum",
        Choices = TIMEZONE_CHOICES,
        Value = "Europe/Brussels"
    })

    return props
end

