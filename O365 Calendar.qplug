if Controls then

------------------------------------ Objects ----------------------------------

-------------------------------- Initialization -------------------------------
function Initialize()
	json = require("rapidjson")

	TENANT_ID = Controls.Tenant_ID.String
	CLIENT_ID = Controls.Client_ID.String
	CLIENT_SECRET = Controls.Client_Secret.String


	COLOR_FREE      = "#43A047" -- green
	COLOR_WARNING   = "#FB8C00" -- orange
	COLOR_OCCUPIED  = "#E53935" -- red

	Controls.RoomStatusColor.Color = "#DCDCDC"
	Controls.RoomStatusColor.String = ""
	Controls.RoomStatusText.String = "Loading..."
	Controls.RoomStatusText.Color = "#3F3F3F"

	-- Room/user mailbox to read
	MAILBOX = Controls.Mailbox.String

	accessToken = nil

	-- Poll every minute
	bookingTimer = Timer.New()
	bookingTimer.EventHandler = function()
	GetBookings()
	end

	GetBookings()
	bookingTimer:Start(Properties["pollingInterval"].Value)

	Controls.Client_ID.EventHandler = SettingsChanged
	Controls.Tenant_ID.EventHandler = SettingsChanged
	Controls.Client_Secret.EventHandler = SettingsChanged
	Controls.Mailbox.EventHandler = SettingsChanged

	LoadSettings()
	Controls.Status.Value = 5
	Controls.Free.Boolean = false
	Controls.Booked.Boolean = false
	Controls.NextSoon.Boolean = false
end

local canInitialize = true

-- Check Properties and other stuff for illegal values

if canInitialize then
	print("Initializing")
	Initialize()
	print("Initialization Complete")
else
	print("Not initializing")
end

-- Nothing should be done after this point

end	--if Controls 
