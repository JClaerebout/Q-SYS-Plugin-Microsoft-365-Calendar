------------------------------ Local Functions --------------------------------
function HEXtoDEC(hex)
	hex = string.upper(hex)
	local b1 = string.byte(string.sub(hex, 1, 1))
	local b2 = string.byte(string.sub(hex, 2, 2))
  
	return( (b1<=57 and b1-48 or b1-55)*16 + (b2<=57 and b2-48 or b2-55) )
end

function ConvertColor(c)
	local t = {}
	t[1] = HEXtoDEC(string.sub(c,2,3))
	t[2] = HEXtoDEC(string.sub(c,4,5))
	t[3] = HEXtoDEC(string.sub(c,6,7))
	return t
end

function GraphTimeToUnix(str)
    local year, month, day, hour, min, sec =
        str:match("(%d+)%-(%d+)%-(%d+)T(%d+):(%d+):(%d+)")

    return os.time({
        year = tonumber(year),
        month = tonumber(month),
        day = tonumber(day),
        hour = tonumber(hour),
        min = tonumber(min),
        sec = tonumber(sec)
    })
end

function FormatTime(unixTime)
    return os.date("%H:%M", unixTime)
end

function UpdateRoomStatus(events)
    local now = os.time()

    local roomBooked = false
    local currentMeeting = nil
    local nextMeeting = nil

    for _, event in ipairs(events) do
        local startUnix = GraphTimeToUnix(event.start.dateTime)
        local endUnix = GraphTimeToUnix(event["end"].dateTime)

        event._startUnix = startUnix
        event._endUnix = endUnix

        if now >= startUnix and now < endUnix then
            roomBooked = true
            currentMeeting = event
        elseif startUnix > now then
            if nextMeeting == nil or startUnix < nextMeeting._startUnix then
                nextMeeting = event
            end
        end
    end

    print("========== ROOM STATUS ==========")

    if roomBooked then
        Controls.RoomStatusColor.Color = COLOR_OCCUPIED
        Controls.NextSoon.Boolean = false
		Controls.Free.Boolean = false
		Controls.Booked.Boolean = true

        if nextMeeting then
            -- Booked now, and another meeting later today
            Controls.RoomStatusText.String =
                "Booked until: " .. FormatTime(currentMeeting._endUnix) ..
                "\n" .. tostring(currentMeeting.subject) ..
                "\n\nNext meeting: " .. FormatTime(nextMeeting._startUnix) .. " - " .. FormatTime(nextMeeting._endUnix) ..
                "\n" .. tostring(nextMeeting.subject)

            print("ROOM IS BOOKED")
            print("Current: " .. tostring(currentMeeting.subject))
            print("Ends: " .. FormatTime(currentMeeting._endUnix))
            print("Next: " .. tostring(nextMeeting.subject))
            print("Next starts: " .. FormatTime(nextMeeting._startUnix))
        else
            -- Booked now, no more meetings after this today
            Controls.RoomStatusText.String =
                "Booked until: " .. FormatTime(currentMeeting._endUnix) ..
                "\n\n" .. tostring(currentMeeting.subject) ..
                "\n\nFree after meeting"

            print("ROOM IS BOOKED")
            print("Current: " .. tostring(currentMeeting.subject))
            print("Ends: " .. FormatTime(currentMeeting._endUnix))
            print("Free after meeting")
        end

    else
        -- Room is free now
		Controls.Free.Boolean = true
		Controls.Booked.Boolean = false
        if nextMeeting then
            local minutesUntilNext = math.floor((nextMeeting._startUnix - now) / 60)

            if minutesUntilNext <= Properties["nextMeetingSoonThreshold"].Value then
                -- Free now, but next meeting soon
                Controls.RoomStatusColor.Color = COLOR_WARNING
                Controls.NextSoon.Boolean = true

                Controls.RoomStatusText.String =
                    "Booked in: " .. tostring(minutesUntilNext) .. " minutes" ..
                    "\n\n" .. tostring(nextMeeting.subject)

                print("ROOM IS FREE - NEXT SOON")
                print("Next: " .. tostring(nextMeeting.subject))
                print("Minutes until next: " .. tostring(minutesUntilNext))
            else
                -- Free now, next meeting later today
                Controls.RoomStatusColor.Color = COLOR_FREE
                Controls.NextSoon.Boolean = false

                Controls.RoomStatusText.String =
                    "Free now" ..
                    "\n\nNext meeting: " .. FormatTime(nextMeeting._startUnix) .. " - " .. FormatTime(nextMeeting._endUnix) ..
                    "\n\n" .. tostring(nextMeeting.subject)

                print("ROOM IS FREE")
                print("Next: " .. tostring(nextMeeting.subject))
                print("Starts: " .. FormatTime(nextMeeting._startUnix))
            end
        else
            -- Free and no more meetings today
            Controls.RoomStatusColor.Color = COLOR_FREE
            Controls.NextSoon.Boolean = false
            Controls.RoomStatusText.String = "Free for the rest of the day"

            print("ROOM IS FREE FOR REST OF DAY")
        end
    end
end

function UrlEncode(str)
  if str then
    str = string.gsub(str, "\n", "\r\n")
    str = string.gsub(str, "([^%w%-_%.~])", function(c)
      return string.format("%%%02X", string.byte(c))
    end)
  end
  return str
end

function GetToken(callback)
  local url = "https://login.microsoftonline.com/" .. TENANT_ID .. "/oauth2/v2.0/token"

  local body =
    "client_id=" .. UrlEncode(CLIENT_ID) ..
    "&scope=" .. UrlEncode("https://graph.microsoft.com/.default") ..
    "&client_secret=" .. UrlEncode(CLIENT_SECRET) ..
    "&grant_type=client_credentials"

  HttpClient.Upload {
    Url = url,
    Method = "POST",
    Data = body,
    Headers = {
      ["Content-Type"] = "application/x-www-form-urlencoded"
    },
    EventHandler = function(_, code, data, err, headers)
      if code == 200 then
        Controls.Status.Value = 0
        local result = json.decode(data)
        accessToken = result.access_token
        print("Token OK")
        if callback then callback() end
      else
        Controls.Status.Value = 2
        Controls.RoomStatusColor.Color = "#DCDCDC"
        Controls.RoomStatusColor.String = ""
        Controls.RoomStatusText.String = "Error Loading Info."
        Controls.RoomStatusText.Color = "#3F3F3F"
        print("Token error: " .. tostring(code))
        print(data or err)
      end
    end
  }
end

function LoadSettings()
    TENANT_ID     = Controls.Tenant_ID.String
    CLIENT_ID     = Controls.Client_ID.String
    CLIENT_SECRET = Controls.Client_Secret.String
    MAILBOX       = Controls.Mailbox.String
end

function SettingsChanged()
    print("Settings changed")

    LoadSettings()

    -- Force new login token
    accessToken = nil

    -- Optional: avoid calling Graph if something is empty
    if TENANT_ID == "" or CLIENT_ID == "" or CLIENT_SECRET == "" or MAILBOX == "" then
        print("Missing settings")
        return
    end

    GetBookings()
end

function GetBookings()
  LoadSettings()

  if TENANT_ID == "" or CLIENT_ID == "" or CLIENT_SECRET == "" or MAILBOX == "" then
      print("Missing settings")
      return
  end

  if accessToken == nil then
    GetToken(GetBookings)
    return
  end

  local now = os.time()
  local t = os.date("*t")
  t.hour = 23
  t.min = 59
  t.sec = 59
  local endOfDay = os.time(t)

  local startTime = os.date("!%Y-%m-%dT%H:%M:%SZ", now)
  local endTime   = os.date("!%Y-%m-%dT%H:%M:%SZ", endOfDay)

  local url =
    "https://graph.microsoft.com/v1.0/users/" .. UrlEncode(MAILBOX) ..
    "/calendarView?startDateTime=" .. UrlEncode(startTime) ..
    "&endDateTime=" .. UrlEncode(endTime) ..
    "&$select=subject,start,end,organizer,isAllDay,showAs" ..
    "&$orderby=start/dateTime"

  local graphTimezone = Properties["Timezone"].Value
  if graphTimezone == nil or graphTimezone == "" then
    graphTimezone = "UTC"
  end

  HttpClient.Download {
    Url = url,
    Headers = {
      ["Authorization"] = "Bearer " .. accessToken,
      ["Accept"] = "application/json",
      ["Prefer"] = 'outlook.timezone="' .. graphTimezone .. '"'
    },
    EventHandler = function(_, code, data, err, headers)
      if code == 200 then
        Controls.Status.Value = 0
        local result = json.decode(data)

        print("Bookings found: " .. tostring(#result.value))

        for i, event in ipairs(result.value) do
          print("-----")
          print("Subject: " .. tostring(event.subject))
          print("Start: " .. tostring(event.start.dateTime))
          print("End: " .. tostring(event["end"].dateTime))
          print("ShowAs: " .. tostring(event.showAs))
        end

        UpdateRoomStatus(result.value)

      elseif code == 401 then
        Controls.Status.Value = 2
        Controls.RoomStatusColor.Color = "#DCDCDC"
        Controls.RoomStatusColor.String = ""
        Controls.RoomStatusText.String = "Error Loading Info."
        Controls.RoomStatusText.Color = "#3F3F3F"
        print("Token expired, retrying...")
        accessToken = nil
        GetToken(GetBookings)

      else
        Controls.Status.Value = 3
        Controls.RoomStatusColor.Color = "#DCDCDC"
        Controls.RoomStatusColor.String = ""
        Controls.RoomStatusText.String = "Error Loading Info."
        Controls.RoomStatusText.Color = "#3F3F3F"
        print("Graph error: " .. tostring(code))
        print(data or err)
      end
    end
  }
end

